PORT=8080
JWT_SECRET=your-super-secret-jwt-key-change-me

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/silpo_agent?sslmode=disable

# URL of the core AI agent (upstream streaming service)
CORE_AGENT_URL=http://localhost:9000
CORE_SERVICE_TOKEN=your-core-service-token

# Silpo custom token refresh endpoint
SILPO_REFRESH_URL=https://api.silpo.ua/auth/refresh

# SMTP settings for sending generated passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com